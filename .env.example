export VS_DATA_LOGGING_LEVEL=DEBUG

# export VSDATA_FM_CONNECTION_STRING="DSN=;UID=;PWD="
export VSDATA_FM_CONNECTION_STRING="Driver={FileMaker ODBC};Server=localhost;Database=;UID=;PWD=;"
export VSDATA_FM_LINK_CONNECTION_STRING="Driver={FileMaker ODBC};Server=localhost;Database=;UID=;PWD=;"

export VSDATA_WC_URL="https://example.com"
export VSDATA_WC_KEY="1234abcd"
export VSDATA_WC_SECRET="1234abcd"

# alias vs="poetry run vs"

# Writable base directory for generated files (exports, caches, audit logs). Defaults to ./tmp;
# set an absolute path when installed in Program Files.
# export VSDATA_TMP_DIR="tmp"
# Optional overrides: VSDATA_CSV_EXPORT_DIR (wholesale CSVs), AUDIT_LOG_DIR (price audit CSVs)

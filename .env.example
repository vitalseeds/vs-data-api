# Copy to `.env` in the repo root (gitignored). Loaded automatically at start-up
# by vs_data_api/env.py. Real environment variables (direnv, shell, service
# manager) take precedence over this file. Set VSDATA_ENV_FILE to use another path.
#
# Quotes are optional and are stripped, `export` prefixes are allowed, so this
# file can be shared with direnv (.envrc) if you want.

VS_DATA_LOGGING_LEVEL=DEBUG

# FileMaker ODBC connection strings.
#   Run inside the Windows VM / on the machine FileMaker is running on: Server=localhost
#   Database= is the open file's name without .fmp12 and must have ODBC sharing on.
# A DSN also works, but must be a *system*, 64 bit DSN that names the database:
# VSDATA_FM_CONNECTION_STRING="DSN=;UID=;PWD="
VSDATA_FM_CONNECTION_STRING="Driver={FileMaker ODBC};Server=localhost;Database=;UID=;PWD=;"
VSDATA_FM_LINK_CONNECTION_STRING="Driver={FileMaker ODBC};Server=localhost;Database=;UID=;PWD=;"

VSDATA_WC_URL="https://example.com"
VSDATA_WC_KEY="1234abcd"
VSDATA_WC_SECRET="1234abcd"

# Used by the tests (tests/conftest.py builds TestSettings from these, even when
# everything is mocked). Point at *test* databases and a staging site, never production.
# VSDATA_TEST_FM_CONNECTION_STRING="Driver={FileMaker ODBC};Server=localhost;Database=;UID=;PWD=;"
# VSDATA_TEST_FM_LINK_CONNECTION_STRING="Driver={FileMaker ODBC};Server=localhost;Database=;UID=;PWD=;"
# VSDATA_TEST_WC_URL="https://staging.example.com"
# VSDATA_TEST_WC_KEY="1234abcd"
# VSDATA_TEST_WC_SECRET="1234abcd"

# Writable base directory for generated files (exports, caches, audit logs). Defaults to ./tmp;
# set an absolute path when installed in Program Files.
# VSDATA_TMP_DIR="tmp"
# Optional overrides: VSDATA_CSV_EXPORT_DIR (wholesale CSVs), AUDIT_LOG_DIR (price audit CSVs)

# vsdata-doctor falls back to this file when there is no config.ini (developer settings, flagged in
# its report). It reads the VSDATA_* settings above, plus VSDATA_WC_VERIFY_SSL=false for a site with a
# self-signed certificate, VSDATA_PORT, and these doctor-only overrides:
# VSDATA_DOCTOR_SERVICE_NAME="vs_data_api"
# VSDATA_DOCTOR_LOG_FILE="C:\logs\vs_data_api_err.log"
